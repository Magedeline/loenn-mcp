<Project Sdk="Microsoft.NET.Sdk">
  <!-- The shared PCG core: no game, editor or package dependencies, so the CLI, the
       CEL mod (net8) and Summer Engine (Godot .NET) can all reference it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>CelPcg</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
